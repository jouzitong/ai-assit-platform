{
  "schemaVersion": "chat-transport-protocol.v2",
  "name": "AI Chat Round Transport Protocol",
  "transport": {
    "supported": [
      "sse",
      "websocket"
    ],
    "sse": {
      "method": "POST",
      "endpoint": "/api/chat/sessions/{sessionCode}/rounds/stream",
      "requestContentType": "application/json",
      "responseContentType": "text/event-stream",
      "eventFrame": {
        "id": "eventId",
        "event": "eventType",
        "data": "json payload"
      }
    },
    "websocket": {
      "endpoint": "/ws/chat",
      "clientMessageType": "chat.user_message",
      "serverEnvelopeField": "eventType"
    }
  },
  "clientRequest": {
    "type": "chat.user_message",
    "requestId": "req_20260708_225812_001",
    "sessionCode": "static-risk-session",
    "roundCode": "risk-round-2",
    "message": {
      "id": "risk-user-1",
      "role": "user",
      "createdAt": "2026-07-08T22:58:12+08:00",
      "content": [
        {
          "type": "text",
          "text": "帮我按优先级列出需要排查的事项。"
        }
      ]
    },
    "clientContext": {
      "timezone": "Asia/Shanghai",
      "locale": "zh-CN",
      "route": "/test/chat",
      "renderCapabilities": [
        "markdown",
        "dashboardCanvas",
        "line-chart",
        "common-list",
        "zg-common-info"
      ]
    }
  },
  "eventEnvelope": {
    "eventId": "evt_000001",
    "eventType": "round.initialized",
    "schemaVersion": "chat-event.v2",
    "requestId": "req_20260708_225812_001",
    "sessionCode": "static-risk-session",
    "roundCode": "risk-round-2",
    "timestamp": "2026-07-08T22:58:12.180+08:00",
    "payload": {}
  },
  "eventTypes": [
    {
      "eventType": "session.initialized",
      "description": "确认或创建会话。只有新会话或首轮对话需要出现，前端据此建立 sessionCode、标题和模型信息。"
    },
    {
      "eventType": "round.initialized",
      "description": "初始化新一轮对话，包含用户消息。前端立即追加用户消息并创建 round 状态。"
    },
    {
      "eventType": "assistant.started",
      "description": "助手接管本轮任务。前端创建助手占位，并把 round/assistant 置为 running。"
    },
    {
      "eventType": "thinking.started",
      "description": "AI 开始思考。前端显示“思考中”，打开思考过程弹窗，并初始化 thinking 面板。"
    },
    {
      "eventType": "thinking.updated",
      "description": "思考过程增量更新。意图分析、规划、执行、检查、节点状态变化都统一走这个事件。"
    },
    {
      "eventType": "thinking.completed",
      "description": "思考过程结束。前端关闭思考过程弹窗，保留顶部思考过程入口，详情通过 sessionCode + roundCode 查询。"
    },
    {
      "eventType": "assistant.message.delta",
      "description": "后端推送完整消息块，不要求 token 级增量。前端可自行做打字机效果，避免后端逐字输出导致乱码或 markdown 半截。"
    },
    {
      "eventType": "artifacts.build",
      "description": "后端生成可独立存在的 artifact 引用，例如 render JSON 的 codeRef。完整 render JSON 通过 codeRef 查询。"
    },
    {
      "eventType": "round.completed",
      "description": "本轮完成，返回最终 round 快照。前端用它校准前面事件产生的本地状态。"
    }
  ],
  "queryContracts": {
    "thinkingDetail": {
      "method": "GET",
      "endpoint": "/api/chat/sessions/{sessionCode}/rounds/{roundCode}/thinking",
      "description": "按 sessionCode + roundCode 获取完整思考过程。",
      "responseSchemaVersion": "round-thinking.v1"
    },
    "renderArtifact": {
      "method": "GET",
      "endpoint": "/api/chat/render-artifacts/{codeRef}",
      "description": "按 codeRef 获取可独立存在的完整 render JSON。",
      "responseSchemaVersion": "render-artifact.v1"
    }
  },
