  "stateApplyRules": [
    {
      "event": "session.initialized",
      "rule": "仅新会话或首轮出现。按 sessionCode 初始化会话元信息。"
    },
    {
      "event": "round.initialized",
      "rule": "按 sessionCode + roundCode 新增 round；若已存在则按 eventId 幂等忽略。"
    },
    {
      "event": "assistant.started",
      "rule": "把 round.assistant.status 置为 running，并创建助手占位。"
    },
    {
      "event": "thinking.started",
      "rule": "初始化 round.assistant.thinking，显示思考中，并打开思考过程弹窗。"
    },
    {
      "event": "thinking.updated",
      "rule": "更新 thinking 摘要和节点状态。意图分析、规划、执行、检查等都归入此事件。完整详情由 thinkingDetail 查询接口提供。"
    },
    {
      "event": "assistant.message.delta",
      "rule": "按 message.id 写入完整消息块；前端可使用 displayMode=typewriter 自行模拟流式输出。"
    },
    {
      "event": "artifacts.build",
      "rule": "把 artifact 引用追加或更新到 round.assistant.artifacts；完整 render JSON 由 codeRef 查询。"
    },
    {
      "event": "thinking.completed",
      "rule": "把 thinking 置为 completed，关闭思考过程弹窗，保留思考入口。"
    },
    {
      "event": "round.completed",
      "rule": "用完整 round 快照校准本地状态，并展示固定的喜欢、反馈按钮。"
    }
  ]
}
