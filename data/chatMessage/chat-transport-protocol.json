{
  "schemaVersion": "chat-transport-protocol.v2",
  "name": "AI Chat Round Transport Protocol",
  "implementation": {
    "eventSchemaVersion": "chat-event.v2",
    "eventIdRule": "运行内主序号；一个内部事件投影为多个协议事件时使用 {sequence}.{subSequence}",
    "identifierOwnership": "sessionCode 为空时由后端创建；roundCode 可由前端提供，为空时由后端创建",
    "compatibility": "SSE 与 WebSocket 使用同一事件包络；SSE id/event 与 data.eventId/data.eventType 保持一致",
    "terminalEvents": [
      "round.completed",
      "round.failed",
      "round.cancelled",
      "assistant.input_required"
    ],
    "successTerminalEvent": "round.completed",
    "transportEndRule": "EOF、HTTP 200、读取超时和 WebSocket close 均不是业务终态；未收到 terminalEvents 时必须进入 RECONNECTING。"
  },
  "transport": {
    "supported": [
      "sse",
      "websocket"
    ],
    "sse": {
      "method": "POST",
      "endpoint": "/api/chat/sessions/{sessionCode}/rounds/stream",
      "newSessionEndpoint": "/api/chat/rounds/stream",
      "reconnectEndpoint": "/api/chat/stream/reconnect",
      "requestContentType": "application/json",
      "responseContentType": "text/event-stream",
      "heartbeat": {
        "frame": ": heartbeat\\n\\n",
        "recommendedIntervalMs": 15000,
        "hasEventId": false,
        "advancesLastEventId": false
      },
      "eventFrame": {
        "id": "eventId",
        "event": "eventType",
        "data": "json payload"
      }
    },
    "websocket": {
      "endpoint": "/ws/chat",
      "clientMessageType": "chat.user_message",
      "clientMessageTypes": [
        "chat.user_message",
        "chat.reconnect",
        "chat.stop"
      ],
      "serverEnvelopeField": "eventType"
    }
  },
  "clientRequest": {
    "type": "chat.user_message",
    "requestId": "req_20260708_225812_001",
    "sessionCode": "static-risk-session",
    "roundCode": "risk-round-2",
    "modelId": 1001,
    "message": {
      "id": "risk-user-1",
      "role": "user",
      "createdAt": "2026-07-08T22:58:12+08:00",
      "content": [
        {
          "type": "text",
          "text": "帮我按优先级列出需要排查的事项。"
        }
      ]
    },
    "clientContext": {
      "timezone": "Asia/Shanghai",
      "locale": "zh-CN",
      "route": "/test/chat",
      "renderCapabilities": [
        "markdown",
        "dashboardCanvas",
        "line-chart",
        "common-list",
        "zg-common-info"
      ]
    }
  },
  "eventEnvelope": {
    "eventId": "evt_000001",
    "eventType": "round.initialized",
    "schemaVersion": "chat-event.v2",
    "runId": "run_01j2example",
    "requestId": "req_20260708_225812_001",
    "sessionCode": "static-risk-session",
    "roundCode": "risk-round-2",
    "timestamp": "2026-07-08T22:58:12.180+08:00",
    "payload": {}
  },
  "eventTypes": [
    {
      "eventType": "run.accepted",
      "description": "任务已进入后端运行池，payload.run.id 即后续重连、状态查询和中断使用的 runId。"
    },
    {
      "eventType": "run.started",
      "description": "后端任务线程已经开始执行；业务助手占位仍由 assistant.started 创建。"
    },
    {
      "eventType": "session.initialized",
      "description": "确认或创建会话。只有新会话或首轮对话需要出现，前端据此建立 sessionCode、标题和模型信息。"
    },
    {
      "eventType": "round.initialized",
      "description": "初始化新一轮对话，包含用户消息。前端立即追加用户消息并创建 round 状态。"
    },
    {
      "eventType": "assistant.started",
      "description": "助手接管本轮任务。前端创建助手占位，并把 round/assistant 置为 running。"
    },
    {
      "eventType": "thinking.started",
      "description": "AI 开始思考。前端显示“思考中”，打开思考过程弹窗，并初始化 thinking 面板。"
    },
    {
      "eventType": "thinking.updated",
      "description": "思考过程增量更新。意图分析、规划、执行、检查、节点状态变化都统一走这个事件。"
    },
    {
      "eventType": "thinking.completed",
      "description": "思考过程结束。前端关闭思考过程弹窗，保留顶部思考过程入口，详情通过 sessionCode + roundCode 查询。"
    },
    {
      "eventType": "assistant.message.delta",
      "description": "后端推送完整消息块，不要求 token 级增量。前端可自行做打字机效果，避免后端逐字输出导致乱码或 markdown 半截。"
    },
    {
      "eventType": "artifacts.build",
      "description": "后端生成可独立存在的 artifact 引用，例如 render JSON 的 codeRef。完整 render JSON 通过 codeRef 查询。"
    },
    {
      "eventType": "round.completed",
      "description": "本轮唯一成功终态，返回最终 round 快照。前端用它校准前面事件产生的本地状态。"
    },
    {
      "eventType": "assistant.input_required",
      "description": "当前流的交互终态，任务进入 WAITING_INPUT；它不是成功或失败终态。当前实现通过新一轮补充输入，WebSocket 可在后续版本中基于同一 run 继续交互。"
    },
    {
      "eventType": "round.failed",
      "description": "本轮失败终态，payload.error 使用安全错误结构；已生成内容和活动应保留，错误卡展示在对应 round 底部而非页面级全局区域。"
    },
    {
      "eventType": "round.cancelled",
      "description": "本轮取消终态，由用户或系统中断；与失败分开展示，中断操作是幂等的。"
    }
  ],
  "queryContracts": {
    "reconnect": {
      "method": "POST",
      "endpoint": "/api/chat/stream/reconnect",
      "request": {
        "type": "chat.reconnect",
        "runId": "run_01j2example",
        "lastEventId": "12.2",
        "sessionCode": "static-risk-session",
        "roundCode": "risk-round-2"
      },
      "description": "优先按 runId 重新订阅；若 lastEventId 含子序号，将从同一主序号恢复且过滤已确认的子事件。运行缓存过期时，使用 sessionCode + roundCode 回放 chat-event.v2 持久化快照。"
    },
    "runStatus": {
      "method": "GET",
      "endpoint": "/api/chat/runs/{runId}",
      "description": "查询任务池中的当前运行状态。"
    },
    "stopRun": {
      "method": "POST",
      "endpoint": "/api/chat/runs/{runId}/stop",
      "description": "幂等中断任务；Redis 模式支持跨后端实例中断。"
    },
    "thinkingDetail": {
      "method": "GET",
      "endpoint": "/api/chat/sessions/{sessionCode}/rounds/{roundCode}/thinking",
      "description": "按 sessionCode + roundCode 获取完整思考过程。",
      "responseSchemaVersion": "round-thinking.v1"
    },
    "renderArtifact": {
      "method": "GET",
      "endpoint": "/api/chat/render-artifacts/{codeRef}",
      "description": "按 codeRef 获取可独立存在的完整 render JSON。",
      "responseSchemaVersion": "render-artifact.v1"
    }
  },
  "recoveryPolicy": {
    "deduplicationKey": [
      "runId",
      "eventId"
    ],
    "persistentReplayDeduplicationKey": [
      "payload.replay.replayId",
      "eventId"
    ],
    "persistentReplayFallback": "缺少 replayId 时按 sessionCode + roundCode + eventType + 业务对象 id 幂等覆盖快照。",
    "eventIdComparison": "按 {sequence}.{subSequence} 数字分段比较，不能按字符串比较。",
    "acknowledgeRule": "事件 JSON 解析并成功应用到本地状态后才能推进 lastEventId。",
    "singleActiveSubscriptionPerRun": true,
    "inactivityTimeoutMs": 30000,
    "inactivityMeaning": "仅表示连接可能失活，不表示任务失败、取消或完成。",
    "maxAutomaticRetries": 3,
    "backoffMs": [
      1000,
      2000,
      4000
    ],
    "jitter": true,
    "retryableTransportConditions": [
      "network_error",
      "timeout",
      "http_408",
      "http_429",
      "http_5xx"
    ],
    "beforeReconnect": "先查询 runStatus；活动任务使用 runId + lastEventId 重连，WAITING_INPUT 停止加载并等待输入，终态或缓存过期时请求持久化快照。",
    "afterRetryExhausted": "保留已接收内容和活动，显示连接已中断，并提供重新连接和停止任务操作。"
  },
  "persistentReplay": {
    "schemaVersion": "chat-event.v2",
    "lookup": [
      "sessionCode",
      "roundCode"
    ],
    "trigger": "运行任务或有限事件缓存已过期。",
    "minimumSnapshotEvents": [
      "session.initialized",
      "round.initialized",
      "assistant.message.delta",
      "one terminal event"
    ],
    "thinkingRecovery": "回放已持久化活动，或返回可查询 thinkingDetail 的引用。",
    "messageApplyMode": "snapshot_replace",
    "optionalReplayMetadata": {
      "replayId": "replay_01j2example",
      "mode": "PERSISTED_SNAPSHOT",
      "source": "CONVERSATION_HISTORY",
      "snapshot": true
    },
    "compatibility": "payload.replay 为可选字段，旧客户端可以忽略；回放 eventId 可重新编号，但同一回放流内必须单调递增；缺少 replayId 时按业务对象幂等覆盖。"
  },
  "errorContract": {
    "payloadField": "payload.error",
    "legacyField": "message",
    "displayScope": "round_footer",
    "fields": {
      "code": "稳定、可枚举的机器错误码，不使用异常类名。",
      "userMessage": "面向用户的中文友好主文案，说明本轮未完成及可采取的下一步，不直接使用后端原始报错。",
      "retryable": "服务端是否建议重试，客户端仍执行有限重试。",
      "traceId": "排障关联标识，建议与 requestId 一致。",
      "detail": "可选的后端脱敏、截断异常摘要，前端默认折叠展示，部署方可以按权限隐藏。"
    },
    "errorCard": {
      "position": "对应 sessionCode + roundCode 的 round 内容底部",
      "primaryText": "payload.error.userMessage",
      "diagnosticFields": [
        "code",
        "traceId"
      ],
      "detailPresentation": "collapsed",
      "retryAction": "仅 retryable=true 时显示“重试本轮”；使用原用户输入创建新执行请求，模型参数按客户端当前选择或轮次上下文策略确定，不复用 FAILED 任务。"
    },
    "globalErrorScope": "仅会话列表、会话详情、模型列表或页面初始化等不归属于具体 round 的加载错误可以使用页面级全局提示。",
    "forbiddenDetail": [
      "api_key",
      "authorization_header",
      "raw_stack_trace",
      "full_model_prompt",
      "unredacted_tool_output"
    ],
    "fallbackUserMessage": "处理失败，请稍后重试。"
  },
  "activityFailurePolicy": {
    "statuses": [
      "pending",
      "running",
      "completed",
      "failed",
      "interrupted",
      "waiting_input"
    ],
    "onRoundFailed": "明确失败的活动置为 failed；结果未知但被终止的活动置为 interrupted。",
    "onRoundCancelled": "仍在 running 的活动置为 interrupted，并记录取消来源。",
    "onInputRequired": "仍在 running 的活动置为 interrupted 或 waiting_input，不得标记为 completed。",
    "persistence": "活动持久化默认 best-effort、异步或 outbox；持久化失败应告警并可标记 persistenceStatus=degraded，但不能隐式导致 round.failed。",
    "security": "活动摘要和详情在持久化与发送前必须裁剪敏感输入和工具输出。"
  },
