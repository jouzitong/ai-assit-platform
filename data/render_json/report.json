      },
      "props": {
        "categories": [
          "1月",
          "2月",
          "3月",
          "4月",
          "5月",
          "6月"
        ],
        "unit": "个",
        "height": "100%",
        "smooth": true,
        "area": false,
        "showSymbol": true,
        "legend": true,
        "series": [
          {
            "name": "新增账户",
            "data": [
              820,
              910,
              1040,
              1120,
              1260,
              1380
            ],
            "showSymbol": true
