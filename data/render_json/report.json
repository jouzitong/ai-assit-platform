{
  "id": "report.test.de",
  "protocol": "render-json",
  "type": "dashboard",
  "protocolVersion": "2.0.0",
  "presentation": {
    "defaultMode": "dashboard",
    "allowedModes": [
      "dashboard",
      "report"
    ],
    "title": "运营数据分析看板",
    "description": "使用 local 数据源展示列表、趋势、能力评估和分类对比。",
    "refreshInterval": 60
  },
  "root": {
    "id": "local-operations-report-root",
    "component": "zg-grid-layout",
    "componentVersion": "1.0.0",
    "layout": {
      "columns": 16,
      "rows": 9,
      "showGrid": true,
      "rowHeight": 88,
      "gap": 16,
      "padding": 16
    }
  },
  "actions": [
    {
      "key": "refresh",
      "name": "刷新",
      "action": "RELOAD",
      "options": {
        "type": "primary",
        "icon": "refresh"
      }
    },
    {
      "key": "print",
      "name": "打印",
      "action": "PRINT",
      "options": {
        "icon": "print"
      }
    },
    {
      "key": "download",
      "name": "下载",
      "action": "DOWNLOAD",
      "options": {
        "icon": "print"
      }
    }
  ],
  "filters": [
    {
      "key": "status",
      "label": "状态",
      "component": "zg-selector",
      "options": {
        "list": [
          {
            "key": "全部",
            "value": ""
          },
          {
            "key": "正常",
            "value": "正常"
          },
          {
            "key": "关注",
            "value": "关注"
          }
        ],
        "clearable": true,
        "filterable": true,
        "submitOnChange": true
      }
    }
  ],
  "components": [
    {
      "id": "operations-list",
      "component": "zg-common-list",
      "componentVersion": "1.0.0",
      "title": "运营明细",
      "layout": [
        1,
        1,
        8,
        5
      ],
      "datasource": {
        "key": "local-operations-list",
        "type": "db-query-list",
        "model": "ods_trade_account_user_address"
      },
      "props": {
        "component": "zg-common-list",
        "title": "运营明细",
        "filters": [
          {
            "key": "status",
            "label": "状态",
            "component": "zg-selector",
            "list": [
              {
                "key": "全部",
                "value": ""
              },
              {
                "key": "正常",
                "value": "正常"
              },
              {
                "key": "关注",
                "value": "关注"
              }
            ],
            "options": {
              "clearable": true,
              "submitOnChange": true
            }
          }
        ],
        "fields": [
          {
            "key": "date",
            "name": "date",
            "label": "日期",
            "field": [
              "date"
            ]
          },
          {
            "key": "category",
            "name": "category",
            "label": "业务分类",
            "field": [
              "category"
            ]
          },
          {
            "key": "owner",
            "name": "owner",
            "label": "负责团队",
            "field": [
              "owner"
            ]
          },
          {
            "key": "metric",
            "name": "metric",
            "label": "指标",
            "field": [
              "metric"
            ]
          },
          {
            "key": "value",
            "name": "value",
            "label": "指标值",
            "field": [
              "value"
            ]
          },
          {
            "key": "status",
            "name": "status",
            "label": "状态",
            "field": [
              "status"
            ]
          }
        ],
        "actions": [],
        "list_config": {
          "variant": "workbench",
          "itemType": "table",
          "pagination": {
            "enabled": true,
            "pageSize": 10,
            "pageSizeOptions": [
              10,
              20,
              50
            ]
          }
        }
      }
    },
    {
      "id": "operations-trend-line",
      "component": "line-chart-renderer",
      "componentVersion": "1.0.0",
      "title": "月度运营趋势",
      "layout": [
        1,
        9,
        8,
        5
      ],
      "datasource": {
        "key": "local-operations-trend",
        "type": "local",
        "data": {
          "list": [
            {
              "month": "1月",
              "newAccounts": 820,
              "activeAccounts": 5200
            },
            {
              "month": "2月",
              "newAccounts": 910,
              "activeAccounts": 5680
            },
            {
              "month": "3月",
              "newAccounts": 1040,
              "activeAccounts": 6120
            },
            {
              "month": "4月",
              "newAccounts": 1120,
              "activeAccounts": 6740
