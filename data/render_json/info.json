{
  "id": "default_config.meta.info.test",
  "version": "1.0.0",
  "title": "系统配置详情",
  "presentation": {
    "defaultMode": "form",
    "allowedModes": [
      "form",
      "standard"
    ]
  },
  "component": "zg-common-form",
  "fields": [
    {
      "key": "id",
      "name": "id",
      "label": "ID",
      "field": [
        "id"
      ],
      "options": {
        "readonly": true
      }
    },
    {
      "key": "config_key",
      "name": "config_key",
      "label": "配置键",
      "field": [
        "config_key"
      ],
      "component": "zg-input",
      "options": {
        "required": true,
        "placeholder": "请输入配置键"
      }
    },
    {
      "key": "value_type",
      "name": "value_type",
      "label": "值类型",
      "field": [
        "value_type"
      ],
      "component": "zg-selector",
      "list": [
        {
          "key": "字符串",
          "value": "string"
        },
        {
          "key": "整数",
          "value": "integer"
        },
        {
          "key": "布尔值",
          "value": "boolean"
        },
        {
          "key": "JSON",
          "value": "json"
        }
      ],
      "options": {
        "required": true,
        "placeholder": "请选择值类型"
      }
    },
    {
      "key": "config_value",
      "name": "config_value",
      "label": "配置值",
      "field": [
        "config_value"
      ],
      "component": "zg-textarea",
      "type": "textarea",
      "options": {
        "required": true,
        "rows": 5,
        "placeholder": "请输入配置值"
      }
    },
    {
      "key": "desc",
      "name": "desc",
      "label": "备注",
      "field": [
        "desc"
      ],
      "component": "zg-textarea",
      "type": "textarea",
      "options": {
        "rows": 3,
        "placeholder": "请输入备注"
      }
    },
    {
      "key": "tags",
      "name": "tags",
      "label": "标签",
      "field": [
        "tags"
      ],
      "component": "zg-input",
      "options": {
        "placeholder": "请输入标签，多个标签使用逗号分隔"
      }
    },
    {
      "key": "deleted",
      "name": "deleted",
      "label": "删除标记",
      "field": [
        "deleted"
      ],
      "component": "zg-switch",
      "type": "switch",
      "options": {},
      "componentProps": {
        "activeValue": 1,
        "inactiveValue": 0,
        "activeText": "已删除",
        "inactiveText": "正常"
      }
    },
    {
      "key": "created_by_name",
      "name": "created_by_name",
      "label": "创建人",
      "field": [
        "sec_user",
        "display_name"
      ],
      "options": {
        "readonly": true
      }
    },
    {
      "key": "update_time",
      "name": "update_time",
      "label": "更新时间",
      "field": [
        "update_time"
      ],
      "options": {
        "readonly": true
      }
    }
  ],
  "groups": [
    {
      "key": "basic",
      "title": "基础信息",
      "description": "查看系统配置项的标识和类型。",
      "fields": [
        "id",
        "config_key",
        "value_type",
        "deleted"
      ],
      "columns": 2
    },
    {
      "key": "content",
      "title": "配置内容",
      "description": "查看配置值、备注和标签。",
      "fields": [
        "config_value",
        "desc",
        "tags"
      ],
      "columns": 1
    },
    {
      "key": "audit",
      "title": "审计信息",
      "fields": [
        "created_by_name",
        "update_time"
      ],
      "columns": 2
    }
  ],
  "children": [],
  "actions": [
    {
      "key": "submit",
      "name": "提交",
      "action": "SUBMIT"
    }
  ],
  "form_relations": [],
  "form_config": {
    "variant": "workbench",
    "columns": 2,
    "description": "根据 formMode 在查看、新增和编辑状态之间切换。",
    "actionsAlign": "right",
    "defaultValues": {
      "value_type": "string",
      "deleted": 0
    },
    "submit": {
      "executor": "render-meta-data"
    }
  },
  "data": {
    "id": 10001,
    "config_key": "render.component.kbId",
    "value_type": "string",
    "config_value": "demo-kb-001",
    "desc": "组件资产默认使用的知识库标识。",
    "tags": "渲染配置,知识库",
    "deleted": 0,
    "sec_user": {
      "display_name": "系统管理员"
    },
    "update_time": "2026-07-29 10:00:00"
  }
}
