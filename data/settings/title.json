      "label": "副标题",
      "field": [
        "subtitle"
      ],
      "options": {
        "styles": {
          "width": 100
        }
      }
    },
    {
      "key": "description",
      "label": "描述",
      "field": [
        "description"
      ],
      "options": {
        "styles": {
          "width": 100
        }
      }
    },
    {
      "key": "icon",
      "label": "图标",
      "field": [
        "icon"
      ],
      "options": {
        "hidden": false
      }
    },
    {
      "key": "tags",
      "label": "标签",
      "field": [
        "tags"
      ],
      "options": {
