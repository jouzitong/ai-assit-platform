  "form_relations": [],
  "life_cycle": {
    "before_load": "=function(){ return true }",
    "after_load": "=function(data){ return data }"
  },
  "data": {
    "title": "系统参数",
    "subtitle": "System Parameters",
    "description": "维护系统级参数、默认开关和全局配置。",
