{
  "id": "list-demo",
  "version": "1.0.0",
  "title": "知识库文档列表示例",
  "component": "common-list",
  "layout": {
    "type": "list",
    "title": "知识库文档中心",
    "description": "用一个 schema 驱动查询区、列表字段、分页和操作栏，作为低代码运行时样板。",
    "meta": "/settings/system/lowcode?viewId=list-demo"
  },
  "datasource": {
    "type": "local",
    "resource": "knowledge-documents",
    "primaryKey": "id"
  },
  "filters": [
    {
      "key": "keyword",
      "label": "搜索",
      "type": "text",
      "action": "keyword-change",
      "defaultValue": "",
      "type_config": {
        "placeholder": "搜索标题 / 负责人 / 摘要",
        "width": 260,
        "clearable": true
      }
    },
    {
      "key": "status",
      "label": "状态",
      "type": "select",
      "action": "status-change",
      "defaultValue": "",
      "type_config": {
        "width": 150,
        "clearable": true,
        "options": [
          { "code": "published", "name": "已发布" },
          { "code": "draft", "name": "草稿" },
          { "code": "archived", "name": "已归档" }
        ]
      }
    },
    {
      "key": "search",
      "label": "查询",
      "type": "button",
      "action": "search",
      "type_config": {
        "width": 88
      }
    },
    {
      "key": "reset",
      "label": "重置",
      "type": "button",
      "action": "reset",
      "variant": "ghost",
      "type_config": {
        "width": 88
      }
    }
  ],
  "fields": [
    { "key": "id", "label": "ID", "width": 8 },
    { "key": "title", "label": "标题", "width": 28 },
    { "key": "owner", "label": "负责人", "width": 14 },
    { "key": "statusLabel", "label": "状态", "width": 12, "className": "status-column" },
    { "key": "updatedAt", "label": "更新时间", "width": 18 },
    { "key": "summary", "label": "摘要", "width": 40 }
  ],
  "actions": [
    { "key": "create", "label": "新建页面", "action": "create", "type": "primary" },
    { "key": "refresh", "label": "刷新", "action": "refresh", "variant": "ghost" }
  ],
  "list_config": {
    "striped": true,
    "sorts_config": {
      "header_enable": true,
      "sorts": ["title", "owner", "updatedAt"]
    },
    "actionColumns": [
      { "key": "detail", "label": "查看" },
      { "key": "edit", "label": "编辑" },
      { "key": "delete", "label": "删除" }
    ],
    "pagination": {
      "enabled": true,
      "pageSize": 5,
      "pageSizeOptions": [5, 10, 20]
    }
  },
  "hooks": {
    "beforeLoad": {
      "type": "builtin",
      "name": "mergeDefaultQuery",
      "params": {
        "status": "published"
      }
    },
    "afterLoad": {
      "type": "builtin",
      "name": "buildListSummary",
      "params": {
        "stats": [
          { "key": "all", "label": "文档总数", "valueFrom": "total" },
          { "key": "published", "label": "已发布", "countBy": { "field": "status", "equals": "published" } },
          { "key": "draft", "label": "草稿", "countBy": { "field": "status", "equals": "draft" } }
        ]
      }
    }
  },
  "mockData": {
    "list": [
      { "id": 1001, "title": "OKR 复盘指引", "owner": "Mia", "status": "published", "statusLabel": "已发布", "updatedAt": "2026-06-25 09:40", "summary": "沉淀季度复盘问题模版和追踪要点。" },
      { "id": 1002, "title": "招聘周报模板", "owner": "Kevin", "status": "draft", "statusLabel": "草稿", "updatedAt": "2026-06-25 08:15", "summary": "用于招聘漏斗和 offer 转化的标准周报视图。" },
      { "id": 1003, "title": "薪酬带宽说明", "owner": "Doris", "status": "published", "statusLabel": "已发布", "updatedAt": "2026-06-24 19:20", "summary": "统一职级薪酬带宽和年度调薪说明口径。" },
      { "id": 1004, "title": "绩效校准会 SOP", "owner": "Mia", "status": "published", "statusLabel": "已发布", "updatedAt": "2026-06-24 17:50", "summary": "包含校准会前准备、会议流程和产出要求。" },
      { "id": 1005, "title": "供应商合同归档规范", "owner": "Jason", "status": "archived", "statusLabel": "已归档", "updatedAt": "2026-06-24 14:10", "summary": "规范外部服务合同和附件的归档目录结构。" },
      { "id": 1006, "title": "入职培训 FAQ", "owner": "Cindy", "status": "published", "statusLabel": "已发布", "updatedAt": "2026-06-24 11:05", "summary": "聚合新员工最常见的制度和系统使用问题。" },
      { "id": 1007, "title": "组织架构同步检查", "owner": "Leo", "status": "draft", "statusLabel": "草稿", "updatedAt": "2026-06-23 18:35", "summary": "描述组织架构同步链路和异常处理步骤。" },
      { "id": 1008, "title": "知识库接入验收清单", "owner": "Kevin", "status": "published", "statusLabel": "已发布", "updatedAt": "2026-06-23 16:22", "summary": "用于新知识源接入前的权限、索引和检索检查。" },
      { "id": 1009, "title": "绩效面谈记录模板", "owner": "Doris", "status": "published", "statusLabel": "已发布", "updatedAt": "2026-06-23 10:45", "summary": "沉淀绩效面谈记录的推荐结构和注意事项。" },
      { "id": 1010, "title": "AI 流程配置演练", "owner": "Jason", "status": "draft", "statusLabel": "草稿", "updatedAt": "2026-06-22 20:30", "summary": "用于培训系统管理同学理解节点、动作和渲染器配置。" }
    ]
  }
}
