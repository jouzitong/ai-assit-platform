@apiPrefix = /user
@resourcePath = /api/v1/system-settings
@internalPath = /internal/v1/system-settings
@id = 1
@page = 1
@size = 10
@sorts = id:desc
@queries = settingKey:system.theme.primary:7
@contentType = application/json;charset=UTF-8
@acceptJson = application/json
@settingKey = system.theme.primary
@jsonSettingKey = system.layout.sidebar
@disabledSettingKey = system.audit.enabled
@missingSettingKey = system.not.exists

### 1. 新增系统配置
POST {{host}}{{apiPrefix}}{{resourcePath}}
Content-Type: {{contentType}}
Accept: {{acceptJson}}
Authorization: Bearer {{token}}

{
  "settingKey": "system.theme.primary",
  "description": "系统主色配置",
  "settingValue": "#0f766e",
  "valueType": "STRING",
  "enabled": true
}

### 2. 全量更新
PUT {{host}}{{apiPrefix}}{{resourcePath}}/{{id}}
Content-Type: {{contentType}}
Accept: {{acceptJson}}
Authorization: Bearer {{token}}

{
  "settingKey": "system.theme.primary",
  "description": "系统主色配置（更新）",
  "settingValue": "#0f9f8c",
  "valueType": "STRING",
  "enabled": true
}

### 3. 局部更新
PATCH {{host}}{{apiPrefix}}{{resourcePath}}/{{id}}
Content-Type: {{contentType}}
Accept: {{acceptJson}}
Authorization: Bearer {{token}}

{
  "settingValue": "#111827",
  "enabled": false
}

### 4. 软删除
DELETE {{host}}{{apiPrefix}}{{resourcePath}}/{{id}}
Accept: {{acceptJson}}
Authorization: Bearer {{token}}

### 5. 物理删除
DELETE {{host}}{{apiPrefix}}{{resourcePath}}/physical/{{id}}
Accept: {{acceptJson}}
Authorization: Bearer {{token}}

### 6. 分页查询（GET）
GET {{host}}{{apiPrefix}}{{resourcePath}}?page={{page}}&size={{size}}&sorts={{sorts}}&queries={{queries}}
Accept: {{acceptJson}}
Authorization: Bearer {{token}}

### 7. 分页搜索（POST /_search）
POST {{host}}{{apiPrefix}}{{resourcePath}}/_search
Content-Type: {{contentType}}
Accept: {{acceptJson}}
Authorization: Bearer {{token}}

{
  "page": {{page}},
  "size": {{size}},
  "keyword": "theme",
  "valueType": "STRING",
  "enabled": true
}

### 8. 按 ID 查询
GET {{host}}{{apiPrefix}}{{resourcePath}}/{{id}}
Accept: {{acceptJson}}
Authorization: Bearer {{token}}

### 9. 内部接口：按 key 查询 value（字符串配置）
GET {{host}}{{apiPrefix}}{{internalPath}}/value?key={{settingKey}}
Accept: {{acceptJson}}
Authorization: Bearer {{token}}

### 10. 内部接口：按 key 查询 value（JSON 配置）
GET {{host}}{{apiPrefix}}{{internalPath}}/value?key={{jsonSettingKey}}
Accept: {{acceptJson}}
Authorization: Bearer {{token}}

### 11. 内部接口：按 key 查询 value（停用配置，预期为空）
GET {{host}}{{apiPrefix}}{{internalPath}}/value?key={{disabledSettingKey}}
Accept: {{acceptJson}}
Authorization: Bearer {{token}}

### 12. 内部接口：按 key 查询 value（不存在的 key，预期为空）
GET {{host}}{{apiPrefix}}{{internalPath}}/value?key={{missingSettingKey}}
Accept: {{acceptJson}}
Authorization: Bearer {{token}}

### 13. 新增 JSON 类型配置
POST {{host}}{{apiPrefix}}{{resourcePath}}
Content-Type: {{contentType}}
Accept: {{acceptJson}}
Authorization: Bearer {{token}}

{
  "settingKey": "system.layout.sidebar",
  "description": "系统侧边栏布局配置",
  "settingValue": "{\"collapsed\":false,\"width\":248}",
  "valueType": "JSON",
  "enabled": true
}

### 14. 新增 BOOLEAN 类型配置
POST {{host}}{{apiPrefix}}{{resourcePath}}
Content-Type: {{contentType}}
Accept: {{acceptJson}}
Authorization: Bearer {{token}}

{
  "settingKey": "system.audit.enabled",
  "description": "系统审计开关",
  "settingValue": "true",
  "valueType": "BOOLEAN",
  "enabled": true
}
