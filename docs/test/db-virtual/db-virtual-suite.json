          { "code": "user_name", "logicalType": "STRING", "nullable": false },
          { "code": "mobile", "logicalType": "STRING", "nullable": false },
          { "code": "user_level", "logicalType": "STRING", "nullable": false },
          { "code": "user_status", "logicalType": "STRING", "nullable": false },
          { "code": "created_at", "logicalType": "TIMESTAMP", "nullable": false }
        ]
      },
      {
        "entityCode": "ods_trade_account_user_address",
        "entityName": "测试用户地址",
        "binding": { "sourceKey": "dbv_mysql_user", "physicalTable": "user_address", "bindingCode": "ods_trade_account_user_address_primary" },
        "fields": [
          { "code": "id", "logicalType": "LONG", "primaryKey": true, "nullable": false },
          { "code": "user_id", "logicalType": "LONG", "nullable": false },
          { "code": "address_type", "logicalType": "STRING", "nullable": false },
          { "code": "city", "logicalType": "STRING", "nullable": false },
          { "code": "detail_address", "logicalType": "STRING", "nullable": false },
          { "code": "is_default", "logicalType": "BOOLEAN", "nullable": false }
        ]
      },
      {
        "entityCode": "ods_trade_account_app_role",
        "entityName": "测试角色",
        "binding": { "sourceKey": "dbv_mysql_user", "physicalTable": "app_role", "bindingCode": "ods_trade_account_app_role_primary" },
        "fields": [
          { "code": "id", "logicalType": "LONG", "primaryKey": true, "nullable": false },
          { "code": "role_code", "logicalType": "STRING", "nullable": false },
          { "code": "role_name", "logicalType": "STRING", "nullable": false }
        ]
      },
      {
        "entityCode": "ods_trade_account_user_role",
        "entityName": "测试用户角色桥接",
        "binding": { "sourceKey": "dbv_mysql_user", "physicalTable": "user_role", "bindingCode": "ods_trade_account_user_role_primary" },
        "fields": [
          { "code": "id", "logicalType": "LONG", "primaryKey": true, "nullable": false },
          { "code": "user_id", "logicalType": "LONG", "nullable": false },
          { "code": "role_id", "logicalType": "LONG", "nullable": false },
          { "code": "granted_at", "logicalType": "TIMESTAMP", "nullable": false }
        ]
      },
      {
        "entityCode": "ods_trade_order_sales_order",
