        "fields": [
          { "code": "id", "logicalType": "LONG", "primaryKey": true, "nullable": false },
          { "code": "order_no", "logicalType": "STRING", "nullable": false },
          { "code": "user_id", "logicalType": "LONG", "nullable": false },
          { "code": "account_id", "logicalType": "LONG", "nullable": false },
          { "code": "order_status", "logicalType": "STRING", "nullable": false },
          { "code": "total_amount", "logicalType": "DECIMAL", "nullable": false },
          { "code": "created_at", "logicalType": "TIMESTAMP", "nullable": false }
        ]
      },
