{
  "schemaVersion": "1.0",
  "name": "db-virtual-three-source-relation-suite",
  "description": "三 MySQL 数据源的虚拟实体、关系定义与 DbQueryApi 验收用例。关系返回形态只由虚拟目录 resultMode 声明。",
  "api": {
    "baseUrlExample": "http://localhost:9764/dbEngine",
    "successCode": 0,
    "responseDataPath": "data"
  },
  "dataSources": [
    {
      "sourceKey": "dbv_mysql_user",
      "database": "db_virtual_user",
      "purpose": "用户、地址、角色与用户角色桥接数据",
      "bootstrapSql": "sql/10-user-info.sql"
    },
    {
      "sourceKey": "dbv_mysql_order",
      "database": "db_virtual_order",
      "purpose": "订单与订单明细数据",
      "bootstrapSql": "sql/20-order.sql"
    },
    {
      "sourceKey": "dbv_mysql_account",
      "database": "db_virtual_account",
      "purpose": "账户与账户流水数据",
      "bootstrapSql": "sql/30-account.sql"
    }
  ],
  "virtualCatalog": {
    "bootstrapSql": "sql/00-create-databases.sql",
    "entities": [
      {
        "entityCode": "ods_trade_account_user_profile",
        "entityName": "测试用户",
