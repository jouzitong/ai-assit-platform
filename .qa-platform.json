{
  "base_url": "https://qa-platform.pp5119259.chatgpt.site/",
  "project": {
    "key": "ai-assit-platform",
    "name": "AI Assist Platform",
    "description": "AI 会话、数据查询、渲染、文件、用户与网关服务的集成测试项目。"
  },
  "variables": {
    "base_url": "127.0.0.1:9764"
  },
  "version": "v0.1.0",
  "api_prefix": "/api/v1",
  "project_id": null,
  "endpoint": "preview",
  "source": "workspace",
  "language": {
    "code": "zh-CN",
    "label": "中文",
    "source": "user_config",
    "confidence": 1.0
  },
  "storage": {
    "directory": "releases/qa-platform-api-test",
    "versioned": true,
    "manifest_filename": "qa-platform-import.json",
    "archive_filename": "qa-platform-import.zip"
  },
  "api_templates": [],
  "success_assertions": {
    "default_assertion": {
      "http": "config:http-success-status",
      "ws": "config:ws-success-messages"
    },
    "definitions": [
      {
        "key": "config:http-success-status",
        "name": "默认 HTTP 成功状态码",
        "engine": "expression",
        "description": "默认 HTTP 成功断言：响应状态码必须在 200–299 范围内。",
        "config": {
          "expression": "response.status >= 200 and response.status <= 299 and response.body.code == 0"
        },
        "default_params": {},
        "severity": "success",
        "message": "HTTP 状态码不在 200–299 范围内"
      },
      {
        "key": "config:ws-success-messages",
        "name": "默认 WebSocket 成功消息",
        "engine": "expression",
        "description": "默认 WebSocket 成功断言：至少收到一条消息。",
        "config": {
          "expression": "len(response.messages) >= params['minimum']"
        },
        "default_params": {
          "minimum": 1
        },
        "severity": "success",
        "message": "WebSocket 未收到成功消息"
      }
    ]
  },
  "flow_documents": [
    {
      "path": "docs/technical/conversation/user-chat-end-to-end.md",
      "required": true
    },
    {
      "path": "docs/test/db-virtual/README.md",
      "required": true
    }
  ],
  "openapi": {
    "documents": [],
    "urls": [],
    "auto_discover": true,
    "runtime_discovery": {
      "enabled": false,
      "scheme": "http",
      "paths": [],
      "timeout_seconds": 3,
      "max_bytes": 10485760
    }
  }
}
