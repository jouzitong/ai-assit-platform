{
  "schemaVersion": "render-component-node-templates/v1",
  "snapshotVersion": "1.0.0",
  "instructions": "Use these as structural examples. Query the live catalog and replace componentVersion and props before validation.",
  "publicRenderers": {
    "zg-list-main-layout": {
      "id": "list-node",
      "component": "zg-list-main-layout",
      "componentVersion": "1.0.0",
      "props": {
        "schema": {
          "id": "list-schema",
          "version": "1.0.0",
          "title": "数据列表",
          "component": "zg-common-list",
          "filters": [],
          "fields": [
            { "key": "id", "name": "id", "label": "编号", "field": ["id"] },
            { "key": "title", "name": "title", "label": "标题", "field": ["title"] }
          ],
          "actions": [],
          "list_config": {
            "itemType": "table",
            "pagination": { "enabled": true, "pageSize": 10, "pageSizeOptions": [10, 20, 50] }
          }
        }
      },
      "datasource": {
        "key": "knowledge-document-query",
        "type": "db-query-list",
        "model": "ai_kb_document",
        "filter_dict": { "status": 1, "is_delete": 0 },
        "filterExpr": "status and is_delete",
        "page": 1,
        "page_size": 10,
        "ext": {
          "fields": ["id", "title", "owner", "deadline", "priority", "tag.title"],
          "relations": [
            {
              "key": "tag",
              "model": "ai_kb_document_tag",
              "type": "left",
              "on": { "id": "document_id" },
              "filter": { "status": 1, "is_delete": 0 }
            }
          ],
          "sorts": [{ "field": "id", "order": "desc" }]
        }
      },
      "layout": { "minHeight": "480px" }
    },
    "form-main-layout": {
      "id": "form-node",
      "component": "form-main-layout",
      "componentVersion": "1.0.0",
      "props": {
        "schema": {
          "id": "form-schema",
          "version": "1.0.0",
          "title": "信息表单",
          "component": "zg-common-form",
          "fields": [
            { "key": "name", "name": "name", "label": "名称", "type": "text", "options": { "required": true, "span": 6 } }
          ],
          "actions": [
            { "key": "save", "name": "保存", "action": "SAVE", "options": { "type": "primary" } }
          ],
          "form_config": { "columns": 2, "actionsAlign": "right" }
        },
        "modelValue": { "name": "示例名称" },
        "readonly": false,
        "formMode": "edit"
      },
      "layout": { "minHeight": "420px" }
    },
    "line-chart-renderer": {
      "id": "line-chart-node",
      "component": "line-chart-renderer",
      "componentVersion": "1.0.0",
      "props": {
        "categories": ["1月", "2月", "3月"],
        "series": [{ "name": "指标", "data": [12, 18, 24] }],
        "height": 320,
        "legend": true,
        "option": {}
      }
    },
    "combo-chart-renderer": {
      "id": "combo-chart-node",
      "component": "combo-chart-renderer",
      "componentVersion": "1.0.0",
      "props": {
        "categories": ["1月", "2月", "3月"],
        "barSeries": [{ "name": "规模", "data": [120, 180, 240] }],
        "lineSeries": [{ "name": "比率", "data": [20, 24, 28], "yAxisIndex": 1 }],
        "height": 320,
        "leftUnit": " 个",
        "rightUnit": "%",
        "option": {}
      }
    },
    "radar-chart-renderer": {
      "id": "radar-chart-node",
      "component": "radar-chart-renderer",
      "componentVersion": "1.0.0",
      "props": {
        "indicators": [
          { "name": "稳定性", "max": 100 },
          { "name": "性能", "max": 100 },
          { "name": "安全性", "max": 100 }
        ],
        "series": [{ "name": "当前值", "data": [86, 92, 88] }],
        "height": 320,
        "legend": true,
        "option": {}
      }
    }
  },
  "runtimeBuiltIns": {
    "zg-page-layout": { "id": "page-node", "component": "zg-page-layout", "componentVersion": "LIVE_VERSION", "layout": { "gap": "24px", "padding": "24px" }, "children": [] },
    "zg-container-layout": { "id": "container-node", "component": "zg-container-layout", "componentVersion": "LIVE_VERSION", "layout": { "gap": "16px" }, "children": [] },
    "zg-section-layout": { "id": "section-node", "component": "zg-section-layout", "componentVersion": "LIVE_VERSION", "layout": { "gap": "16px" }, "children": [] },
    "zg-stack-layout": { "id": "stack-node", "component": "zg-stack-layout", "componentVersion": "LIVE_VERSION", "layout": { "direction": "row", "wrap": true, "gap": "12px" }, "children": [] },
    "zg-grid-layout": { "id": "grid-node", "component": "zg-grid-layout", "componentVersion": "LIVE_VERSION", "layout": { "gridTemplateColumns": "repeat(2, minmax(0, 1fr))", "gap": "16px" }, "children": [] },
    "zg-split-layout": { "id": "split-node", "component": "zg-split-layout", "componentVersion": "LIVE_VERSION", "layout": { "gridTemplateColumns": "minmax(240px, 1fr) minmax(0, 2fr)", "gap": "20px" }, "children": [] },
    "zg-sheet-layout": { "id": "sheet-node", "component": "zg-sheet-layout", "componentVersion": "LIVE_VERSION", "layout": { "gap": "20px", "minHeight": "720px" }, "children": [] },
    "heading": { "id": "heading-node", "component": "heading", "componentVersion": "LIVE_VERSION", "props": { "text": "页面标题" } },
    "text": { "id": "text-node", "component": "text", "componentVersion": "LIVE_VERSION", "props": { "text": "页面说明文字。" } }
  }
}
