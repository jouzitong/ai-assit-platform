{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-assit-platform.local/schemas/validation-report/v1",
  "title": "ValidationReport",
  "description": "Deterministic validation evidence for a Render JSON document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "valid",
    "documentHash",
    "rulesVersion",
    "catalogRevision",
    "errors",
    "warnings",
    "stats",
    "summary"
  ],
  "properties": {
    "schemaVersion": {
      "const": "validation-report/v1"
    },
    "valid": {
      "type": "boolean"
    },
    "documentHash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "rulesVersion": {
      "type": "string",
      "minLength": 1
    },
    "ruleVersion": {
      "type": "string",
      "minLength": 1
    },
    "catalogRevision": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Compatibility field containing the component source reference used for authoring."
    },
    "protocolVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "stats": {
      "$ref": "#/$defs/stats"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "valid": {
            "const": true
          }
        },
        "required": [
          "valid"
        ]
      },
      "then": {
        "properties": {
          "errors": {
            "maxItems": 0
          },
          "stats": {
            "properties": {
              "errorCount": {
                "const": 0
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "errors": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message",
        "jsonPath",
        "repairable",
        "stage"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
        },
        "severity": {
          "enum": [
            "ERROR",
            "WARNING"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "jsonPath": {
          "type": "string",
          "minLength": 1
        },
        "nodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "repairable": {
          "type": "boolean"
        },
        "recoverable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeCount",
        "componentCount",
        "maxDepth",
        "errorCount",
        "warningCount"
      ],
      "properties": {
        "nodeCount": {
          "type": "integer",
          "minimum": 0
        },
        "componentCount": {
          "type": "integer",
          "minimum": 0
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0
        },
        "errorCount": {
          "type": "integer",
          "minimum": 0
        },
        "warningCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
