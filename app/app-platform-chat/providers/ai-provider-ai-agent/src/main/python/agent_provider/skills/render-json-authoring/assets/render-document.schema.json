{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-assit-platform.local/schemas/render-document/v1",
  "title": "RenderDocument",
  "description": "A declarative Render JSON document composed from components approved by the authoring skill.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "protocolVersion",
    "pageId",
    "root"
  ],
  "properties": {
    "protocol": {
      "const": "render-json"
    },
    "protocolVersion": {
      "enum": [
        "1.0",
        "1.0.0"
      ]
    },
    "pageId": {
      "$ref": "#/$defs/stableKey"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "root": {
      "$ref": "#/$defs/renderNode"
    }
  },
  "$defs": {
    "stableKey": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "jsonObject": {
      "type": "object"
    },
    "renderNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "componentVersion"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableKey"
        },
        "component": {
          "$ref": "#/$defs/stableKey"
        },
        "componentVersion": {
          "type": "string",
          "minLength": 1
        },
        "props": {
          "$ref": "#/$defs/jsonObject"
        },
        "layout": {
          "$ref": "#/$defs/jsonObject"
        },
        "datasource": {
          "$ref": "#/$defs/datasource"
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/binding"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/renderNode"
          }
        }
      }
    },
    "datasource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/stableKey"
        },
        "type": {
          "enum": [
            "direct-json",
            "db-query-list",
            "semantic-query",
            "preview-result",
            "static"
          ]
        },
        "model": {
          "$ref": "#/$defs/stableKey"
        },
        "queryType": {
          "enum": ["list", "count", "aggregate"]
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "filter_dict": {
          "type": "object"
        },
        "filterExpr": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.()\\s]*$"
        },
        "ext": {
          "type": "object"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableKey"
          },
          "uniqueItems": true
        },
        "dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableKey" },
          "uniqueItems": true
        },
        "measures": {
          "type": "array",
          "items": { "$ref": "#/$defs/measure" }
        },
        "filters": {
          "type": "array",
          "items": { "$ref": "#/$defs/queryFilter" }
        },
        "timeRange": {
          "$ref": "#/$defs/timeRange"
        },
        "sorts": {
          "type": "array",
          "items": { "$ref": "#/$defs/querySort" }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "contractRef": {
          "type": "string",
          "minLength": 1
        },
        "previewProofRef": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "object"
        },
        "data": true
      },
      "allOf": [
        {
          "if": { "required": ["queryType"] },
          "then": { "properties": { "type": { "const": "semantic-query" } } }
        },
        {
          "if": {
            "properties": { "queryType": { "const": "list" } },
            "required": ["queryType"]
          },
          "then": {
            "properties": { "fields": { "minItems": 1 } },
            "required": ["fields"]
          }
        },
        {
          "if": {
            "properties": { "queryType": { "const": "count" } },
            "required": ["queryType"]
          },
          "then": {
            "properties": {
              "type": { "const": "semantic-query" },
              "fields": { "minItems": 1 },
              "dimensions": { "maxItems": 0 },
              "measures": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": { "aggregation": { "const": "count" } },
                  "required": ["aggregation"]
                }
              }
            },
            "required": ["type", "model", "fields", "contractRef", "previewProofRef", "measures"]
          }
        },
        {
          "if": {
            "properties": { "queryType": { "const": "aggregate" } },
            "required": ["queryType"]
          },
          "then": {
            "properties": {
              "type": { "const": "semantic-query" },
              "fields": { "minItems": 1 },
              "measures": { "minItems": 1 }
            },
            "required": ["type", "model", "fields", "contractRef", "previewProofRef", "measures"]
          }
        }
      ]
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "aggregation"],
      "properties": {
        "field": { "$ref": "#/$defs/stableKey" },
        "aggregation": { "enum": ["count", "sum", "min", "max", "avg"] },
        "label": { "type": "string" },
        "alias": { "$ref": "#/$defs/stableKey" }
      }
    },
    "queryFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator"],
      "properties": {
        "field": { "$ref": "#/$defs/stableKey" },
        "operator": { "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in", "not_in", "is_null", "is_not_null", "like", "starts_with", "ends_with"] },
        "value": true,
        "values": { "type": "array" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "operator": { "enum": ["in", "not_in"] } },
            "required": ["operator"]
          },
          "then": {
            "required": ["values"],
            "not": { "required": ["value"] }
          }
        },
        {
          "if": {
            "properties": { "operator": { "enum": ["is_null", "is_not_null"] } },
            "required": ["operator"]
          },
          "then": {
            "not": { "anyOf": [{ "required": ["value"] }, { "required": ["values"] }] }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "not": { "enum": ["in", "not_in", "is_null", "is_not_null"] }
              }
            },
            "required": ["operator"]
          },
          "then": {
            "required": ["value"],
            "not": { "required": ["values"] }
          }
        }
      ]
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": { "$ref": "#/$defs/stableKey" },
        "preset": { "type": "string" },
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "querySort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": { "$ref": "#/$defs/stableKey" },
        "direction": { "enum": ["ASC", "DESC", "asc", "desc"] }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)*(?:\\[\\d+\\])?$"
        },
        "transform": {
          "enum": [
            "identity",
            "number",
            "percent",
            "currency",
            "date",
            "datetime",
            "category-series"
          ]
        },
        "fallback": true
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": {
          "$ref": "#/$defs/stableKey"
        },
        "name": {
          "$ref": "#/$defs/stableKey"
        },
        "type": {
          "$ref": "#/$defs/stableKey"
        },
        "actionRef": {
          "$ref": "#/$defs/stableKey"
        },
        "action": {
          "$ref": "#/$defs/stableKey"
        }
      },
      "anyOf": [
        {
          "required": ["event"]
        },
        {
          "required": ["name"]
        },
        {
          "required": ["type"]
        }
      ],
      "allOf": [
        {
          "anyOf": [
            {"required": ["actionRef"]},
            {"required": ["action"]}
          ]
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/stableKey"
        },
        "type": {
          "enum": [
            "filter.update",
            "selection.update",
            "navigation.local",
            "refresh",
            "dialog.open"
          ]
        },
        "target": {
          "$ref": "#/$defs/stableKey"
        },
        "params": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    }
  }
}
