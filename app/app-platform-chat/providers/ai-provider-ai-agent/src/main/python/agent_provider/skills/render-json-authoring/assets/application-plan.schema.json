{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-assit-platform.local/schemas/application-plan/v1",
  "title": "ApplicationPlan",
  "description": "A catalog-bound plan that connects a previewed semantic contract to an application layout.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "inputRefs",
    "page",
    "datasources",
    "components",
    "bindings",
    "interactions",
    "catalogRevision",
    "assumptions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "application-plan/v1"
    },
    "inputRefs": {
      "$ref": "#/$defs/inputRefs"
    },
    "page": {
      "$ref": "#/$defs/page"
    },
    "datasources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/datasource"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "interactions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interaction"
      }
    },
    "catalogRevision": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "stableKey": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "artifactRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "inputRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationBrief",
        "dataContract",
        "dataPreviewProof"
      ],
      "properties": {
        "applicationBrief": {
          "$ref": "#/$defs/artifactRef"
        },
        "dataContract": {
          "$ref": "#/$defs/artifactRef"
        },
        "dataPreviewProof": {
          "$ref": "#/$defs/artifactRef"
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "pageType",
        "layout"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "pageType": {
          "enum": [
            "dashboard",
            "list",
            "detail",
            "hybrid"
          ]
        },
        "layout": {
          "enum": [
            "grid",
            "stack",
            "split",
            "master-detail"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "datasource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "model",
        "queryType",
        "contractRef",
        "previewProofRef",
        "fields"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/stableKey"
        },
        "model": {
          "$ref": "#/$defs/stableKey"
        },
        "queryType": {
          "enum": [
            "list",
            "aggregate",
            "pivot"
          ]
        },
        "contractRef": {
          "$ref": "#/$defs/artifactRef"
        },
        "previewProofRef": {
          "$ref": "#/$defs/artifactRef"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stableKey"
          },
          "uniqueItems": true
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "component",
        "purpose"
      ],
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/stableKey"
        },
        "component": {
          "$ref": "#/$defs/stableKey"
        },
        "componentVersion": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "parentNodeId": {
          "$ref": "#/$defs/stableKey"
        },
        "props": {
          "type": "object"
        },
        "layout": {
          "type": "object"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "target",
        "datasource",
        "source"
      ],
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/stableKey"
        },
        "target": {
          "$ref": "#/$defs/stableKey"
        },
        "datasource": {
          "$ref": "#/$defs/stableKey"
        },
        "source": {
          "$ref": "#/$defs/stableKey"
        },
        "transform": {
          "enum": [
            "identity",
            "number",
            "percent",
            "currency",
            "date",
            "datetime",
            "category-series"
          ]
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceNodeId",
        "event",
        "action",
        "target"
      ],
      "properties": {
        "sourceNodeId": {
          "$ref": "#/$defs/stableKey"
        },
        "event": {
          "$ref": "#/$defs/stableKey"
        },
        "action": {
          "enum": [
            "filter.update",
            "selection.update",
            "navigation.local",
            "refresh",
            "dialog.open"
          ]
        },
        "target": {
          "$ref": "#/$defs/stableKey"
        }
      }
    }
  }
}
