{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-assit-platform.local/schemas/application-plan/v1",
  "title": "ApplicationPlan",
  "description": "A skill-bound plan that connects a previewed semantic contract to an application layout.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "inputRefs",
    "page",
    "datasources",
    "components",
    "bindings",
    "interactions",
    "catalogRevision",
    "assumptions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "application-plan/v1"
    },
    "inputRefs": {
      "$ref": "#/$defs/inputRefs"
    },
    "page": {
      "$ref": "#/$defs/page"
    },
    "datasources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/datasource"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "interactions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interaction"
      }
    },
    "catalogRevision": {
      "type": "string",
      "minLength": 1,
      "description": "Compatibility field containing the frozen component source reference, currently skill://render-json-authoring/v6."
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "stableKey": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "artifactRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "inputRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationBrief",
        "dataContract",
        "dataPreviewProof"
      ],
      "properties": {
        "applicationBrief": {
          "$ref": "#/$defs/artifactRef"
        },
        "dataContract": {
          "$ref": "#/$defs/artifactRef"
        },
        "dataPreviewProof": {
          "$ref": "#/$defs/artifactRef"
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "pageType",
        "layout"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "pageType": {
          "enum": [
            "dashboard",
            "list",
            "detail",
            "hybrid"
          ]
        },
        "layout": {
          "enum": [
            "grid",
            "stack",
            "split",
            "master-detail"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "datasource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "model",
        "queryType",
        "contractRef",
        "previewProofRef",
        "fields"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/stableKey"
        },
        "model": {
          "$ref": "#/$defs/stableKey"
        },
        "queryType": {
          "enum": [
            "list",
            "count",
            "aggregate",
            "pivot"
          ]
        },
        "contractRef": {
          "$ref": "#/$defs/artifactRef"
        },
        "previewProofRef": {
          "$ref": "#/$defs/artifactRef"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stableKey"
          },
          "uniqueItems": true
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableKey"
          },
          "uniqueItems": true
        },
        "measures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/measure"
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/filter"
          }
        },
        "timeRange": {
          "$ref": "#/$defs/timeRange"
        },
        "sorts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sort"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "queryType": { "const": "count" } },
            "required": ["queryType"]
          },
          "then": {
            "properties": {
              "dimensions": { "maxItems": 0 },
              "measures": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": { "aggregation": { "const": "count" } },
                  "required": ["aggregation"]
                }
              }
            },
            "required": ["measures"]
          }
        },
        {
          "if": {
            "properties": { "queryType": { "const": "aggregate" } },
            "required": ["queryType"]
          },
          "then": {
            "properties": { "measures": { "minItems": 1 } },
            "required": ["measures"]
          }
        }
      ]
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "aggregation"],
      "properties": {
        "field": { "$ref": "#/$defs/stableKey" },
        "aggregation": { "enum": ["count", "sum", "min", "max", "avg"] },
        "label": { "type": "string" },
        "alias": { "$ref": "#/$defs/stableKey" }
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator"],
      "properties": {
        "field": { "$ref": "#/$defs/stableKey" },
        "operator": { "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in", "not_in", "is_null", "is_not_null", "like", "starts_with", "ends_with"] },
        "value": true,
        "values": { "type": "array" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "operator": { "enum": ["in", "not_in"] } },
            "required": ["operator"]
          },
          "then": {
            "required": ["values"],
            "not": { "required": ["value"] }
          }
        },
        {
          "if": {
            "properties": { "operator": { "enum": ["is_null", "is_not_null"] } },
            "required": ["operator"]
          },
          "then": {
            "not": { "anyOf": [{ "required": ["value"] }, { "required": ["values"] }] }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "not": { "enum": ["in", "not_in", "is_null", "is_not_null"] }
              }
            },
            "required": ["operator"]
          },
          "then": {
            "required": ["value"],
            "not": { "required": ["values"] }
          }
        }
      ]
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": { "$ref": "#/$defs/stableKey" },
        "preset": { "type": "string" },
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "sort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": { "$ref": "#/$defs/stableKey" },
        "direction": { "enum": ["ASC", "DESC", "asc", "desc"] }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "component",
        "purpose"
      ],
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/stableKey"
        },
        "component": {
          "$ref": "#/$defs/stableKey"
        },
        "componentVersion": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "parentNodeId": {
          "$ref": "#/$defs/stableKey"
        },
        "props": {
          "type": "object"
        },
        "layout": {
          "type": "object"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "target",
        "datasource",
        "source"
      ],
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/stableKey"
        },
        "target": {
          "$ref": "#/$defs/stableKey"
        },
        "datasource": {
          "$ref": "#/$defs/stableKey"
        },
        "source": {
          "$ref": "#/$defs/stableKey"
        },
        "transform": {
          "enum": [
            "identity",
            "number",
            "percent",
            "currency",
            "date",
            "datetime",
            "category-series"
          ]
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceNodeId",
        "event",
        "action",
        "target"
      ],
      "properties": {
        "sourceNodeId": {
          "$ref": "#/$defs/stableKey"
        },
        "event": {
          "$ref": "#/$defs/stableKey"
        },
        "action": {
          "enum": [
            "filter.update",
            "selection.update",
            "navigation.local",
            "refresh",
            "dialog.open"
          ]
        },
        "target": {
          "$ref": "#/$defs/stableKey"
        }
      }
    }
  }
}
