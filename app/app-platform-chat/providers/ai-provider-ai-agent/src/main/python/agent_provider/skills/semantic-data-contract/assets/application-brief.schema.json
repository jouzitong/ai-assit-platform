{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-assit-platform.local/schemas/application-brief/v1",
  "title": "ApplicationBrief",
  "description": "A clarified, user-facing request for a data application.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "goal",
    "targetUsers",
    "businessQuestions",
    "metrics",
    "dimensions",
    "filters",
    "displayPreferences",
    "allowCreatePage",
    "clarifications",
    "assumptions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "application-brief/v1"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "targetUsers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "businessQuestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/businessTerm"
      },
      "uniqueItems": true
    },
    "dimensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/businessTerm"
      },
      "uniqueItems": true
    },
    "timeRange": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/timeRange"
        }
      ]
    },
    "filters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requestedFilter"
      }
    },
    "displayPreferences": {
      "$ref": "#/$defs/displayPreferences"
    },
    "allowCreatePage": {
      "type": "boolean"
    },
    "clarifications": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "businessTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "aggregation": {
          "enum": [
            "count",
            "sum",
            "avg",
            "min",
            "max",
            "none"
          ]
        }
      }
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      },
      "anyOf": [
        {
          "required": [
            "preset"
          ]
        },
        {
          "required": [
            "start",
            "end"
          ]
        }
      ]
    },
    "requestedFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "minLength": 1
        },
        "value": true
      }
    },
    "displayPreferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pageType": {
          "enum": [
            "dashboard",
            "list",
            "detail",
            "hybrid",
            "unspecified"
          ]
        },
        "chartTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "layout": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
