<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ai.platform.aiassit.model.mapper.AiModelManageMapper">

    <resultMap id="AiModelManageResultMap" type="ai.platform.aiassit.model.entity.vo.AiModelManageVO">
        <id property="id" column="id"/>
        <result property="modelCode" column="model_code"/>
        <result property="modelName" column="model_name"/>
        <result property="providerCode" column="provider_code"/>
        <result property="providerName" column="provider_name"/>
        <result property="baseUrl" column="base_url"/>
        <result property="apiModel" column="api_model"/>
        <result property="enabled" column="enabled"/>
        <result property="apiKeyMasked" column="api_key_masked"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createdBy" column="created_by"/>
        <result property="lastModifiedBy" column="last_modified_by"/>
        <result property="version" column="version"/>
        <result property="extJson" column="ext_json" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
    </resultMap>

    <sql id="AggregateColumns">
        m.id,
        m.model_code,
        m.model_name,
        m.provider_code,
        m.provider_name,
        m.base_url,
        m.api_model,
        m.enabled,
        CASE
            WHEN m.api_key IS NULL OR m.api_key = '' THEN NULL
            WHEN CHAR_LENGTH(m.api_key) &lt;= 2 THEN CONCAT(SUBSTRING(m.api_key, 1, 1), '***', SUBSTRING(m.api_key, CHAR_LENGTH(m.api_key), 1))
            WHEN CHAR_LENGTH(m.api_key) &lt;= 8 THEN CONCAT(SUBSTRING(m.api_key, 1, 2), '****', SUBSTRING(m.api_key, CHAR_LENGTH(m.api_key), 1))
            ELSE CONCAT(SUBSTRING(m.api_key, 1, 4), '****', SUBSTRING(m.api_key, CHAR_LENGTH(m.api_key) - 3, 4))
        END AS api_key_masked,
        m.ext_json,
        m.create_time,
        m.update_time,
        m.created_by,
        m.updated_by AS last_modified_by,
        m.version
    </sql>

    <sql id="AggregateFrom">
        FROM ai_model_config m
    </sql>

    <sql id="AggregateWhere">
        <if test="query != null">
            <if test="query.providerCode != null and query.providerCode != ''">
                AND m.provider_code = #{query.providerCode}
            </if>
            <if test="query.modelCode != null and query.modelCode != ''">
                AND m.model_code = #{query.modelCode}
            </if>
            <if test="query.enabled != null">
                AND m.enabled = #{query.enabled}
            </if>
            <if test="query.keyword != null and query.keyword != ''">
                AND (
                    m.model_code LIKE CONCAT('%', #{query.keyword}, '%')
                    OR m.model_name LIKE CONCAT('%', #{query.keyword}, '%')
                    OR m.api_model LIKE CONCAT('%', #{query.keyword}, '%')
                    OR m.provider_code LIKE CONCAT('%', #{query.keyword}, '%')
                    OR m.provider_name LIKE CONCAT('%', #{query.keyword}, '%')
                    OR m.base_url LIKE CONCAT('%', #{query.keyword}, '%')
                    OR m.ext_json LIKE CONCAT('%', #{query.keyword}, '%')
                )
            </if>
        </if>
    </sql>

    <select id="pageAggregate" resultMap="AiModelManageResultMap">
        SELECT
        <include refid="AggregateColumns"/>
        <include refid="AggregateFrom"/>
        WHERE 1 = 1
        <include refid="AggregateWhere"/>
        ORDER BY
            COALESCE(CAST(JSON_UNQUOTE(JSON_EXTRACT(m.ext_json, '$.priority')) AS SIGNED), 100) ASC,
            m.update_time DESC,
            m.id DESC
    </select>

    <select id="selectByModelId" resultMap="AiModelManageResultMap">
        SELECT
        <include refid="AggregateColumns"/>
        <include refid="AggregateFrom"/>
        WHERE 1 = 1
        AND m.id = #{id}
        LIMIT 1
    </select>
</mapper>
