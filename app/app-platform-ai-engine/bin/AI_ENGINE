#!/bin/bash

set -u

JAVA_HOME_DEFAULT='/usr/local/jdk17'
APP_NAME="ai-engine"
BOOT_JAR="app.jar"

BIN_FILE=$(readlink -f "$0")
cd "$(dirname "${BIN_FILE}")"
BIN_DIR=$(pwd)
BASE_DIR=$(cd .. && pwd)

PID_DIR="${BASE_DIR}/pid"
PID_FILE="${PID_DIR}/app.pid"
LOG_DIR="${BASE_DIR}/logs"
APP_LOG="${LOG_DIR}/app.log"
CONFIG_DIR="${BASE_DIR}/config"
THIRD_PART_LIB_DIR="${BASE_DIR}/lib"
CE_LIB_DIR="${BASE_DIR}/celib"
LIB_DIR="${THIRD_PART_LIB_DIR},${CE_LIB_DIR}"

if [ ! -d "${PID_DIR}" ]; then
    mkdir -p "${PID_DIR}"
fi

if [ ! -d "${LOG_DIR}" ]; then
    mkdir -p "${LOG_DIR}"
fi

if [ -n "${JAVA_HOME:-}" ] && [ -x "${JAVA_HOME}/bin/java" ]; then
    JAVA_BIN="${JAVA_HOME}/bin/java"
elif [ -x "${JAVA_HOME_DEFAULT}/bin/java" ]; then
    JAVA_BIN="${JAVA_HOME_DEFAULT}/bin/java"
else
    JAVA_BIN="java"
fi

usage() {
    echo "Usage: $0 [start|stop|restart|status|version] [profile]"
    exit 1
}

get_pid() {
    pid=""
    if [ -f "${PID_FILE}" ]; then
        if [ -r "${PID_FILE}" ]; then
            pid=$(cat "${PID_FILE}")
            if [ -n "${pid}" ]; then
                pid=$(ps -p "${pid}" | grep "${pid}" | grep -v grep | awk '{print $1}' | tail -1)
            fi
        else
            echo "Cannot read pidfile: ${PID_FILE}."
            exit 1
        fi
    fi
}

is_running() {
    get_pid
    if [ -n "${pid}" ]; then
        return 0
    else
        return 1
    fi
}

JAVA_OPTS="-server"
JAVA_OPTS="${JAVA_OPTS} -Dname=${APP_NAME}"
JAVA_OPTS="${JAVA_OPTS} -Dloader.path=${LIB_DIR}"
JAVA_OPTS="${JAVA_OPTS} -Dlogging.config=${CONFIG_DIR}/logback-spring.xml"
JAVA_OPTS="${JAVA_OPTS} -Dspring.config.additional-location=${CONFIG_DIR}/"
JAVA_OPTS="${JAVA_OPTS} -Dspring.profiles.active=prod"

start() {
    local profile="${1:-}"
    cd "${BASE_DIR}" || exit 1

    if [ -n "${profile}" ]; then
        JAVA_OPTS=$(echo "${JAVA_OPTS}" | sed 's/-Dspring\.profiles\.active=[^ ]*//g')
        JAVA_OPTS="${JAVA_OPTS} -Dspring.profiles.active=${profile}"
    fi

    echo "start ${APP_NAME}"
    echo "JAVA_BIN: ${JAVA_BIN}"
    echo "JAVA_OPTS: ${JAVA_OPTS}"
    echo "BOOT_JAR: ${BOOT_JAR}"

    if ! is_running; then
        if setsid nohup "${JAVA_BIN}" ${JAVA_OPTS} -jar "${BOOT_JAR}" >> "${APP_LOG}" 2>&1 < /dev/null &
        then
            pid=$!
            if [ -n "${pid}" ]; then
                echo "${pid}" > "${PID_FILE}"
                echo "Starting ${APP_NAME} ..."
            else
                echo "${APP_NAME} started FAILED1"
                exit 1
            fi
        else
            echo "${APP_NAME} started FAILED2"
            exit 1
        fi
    else
        echo "${APP_NAME} is already running..."
    fi
}

stop() {
    if is_running; then
        kill "$(cat "${PID_FILE}")"
        echo "Stopping ${APP_NAME} ... OK"
    else
        echo "${APP_NAME} is not running..."
    fi
    rm -f "${PID_FILE}"
}

restart() {
    stop
    start "${1:-}"
}

status() {
    if is_running; then
        echo "${APP_NAME} is running"
        return 1
    else
        echo "${APP_NAME} is not running"
        return 0
    fi
}

version() {
    echo "${APP_NAME}"
    echo "JAVA_BIN: ${JAVA_BIN}"
    echo "BOOT_JAR: ${BOOT_JAR}"
}

case "${1:-}" in
    start)
        start "${2:-}"
        ;;
    stop)
        stop
        ;;
    restart)
        restart "${2:-}"
        ;;
    status)
        status
        ;;
    version)
        version
        ;;
    *)
        usage
        ;;
esac
