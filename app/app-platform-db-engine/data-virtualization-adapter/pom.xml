            <artifactId>app-platform-db-engine-db-executor-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.platform.aiassit</groupId>
            <artifactId>commons-lib-data-virtualization-api</artifactId>
            <version>${project.version}</version>
